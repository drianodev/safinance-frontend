# ==============================================================================
# Safinance - Hostinger Apache / LiteSpeed Configuration (.htaccess)
# ==============================================================================

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Ensure index.html is served directly
  RewriteRule ^index\.html$ - [L]

  # Redirect existing files and directories directly
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME} !-l

  # Single Page Application (SPA) Fallback to index.html
  RewriteRule . /index.html [L]
</IfModule>

# ==============================================================================
# Security & MIME Type Headers
# ==============================================================================
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Service Worker & HTML must always be fresh
  <FilesMatch "(sw\.js|index\.html|site\.webmanifest)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # Vite hashed assets (JS/CSS) are immutable and cached for 1 year
  <FilesMatch "\.(js|css|woff2|woff|png|jpg|jpeg|svg|webp|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ==============================================================================
# Gzip / Brotli Compression
# ==============================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json application/xml image/svg+xml
</IfModule>
